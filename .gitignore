# Benchmarks: track source, ignore artifacts.
# Exception: the paper's own results are committed on purpose. 07_appendix.tex
# promises readers the raw per-question CSVs and the summary CSVs and LaTeX
# tables in locomo_local/ are committed, so any reader can re-run the analysis
# without re-running the eval. Keep these tracked.
benchmarks/results/*
!benchmarks/results/locomo_local/
benchmarks/results/locomo_local/*
!benchmarks/results/locomo_local/*.csv
!benchmarks/results/locomo_local/*.tex
!benchmarks/results/locomo_local/*.txt
benchmarks/__pycache__/
benchmarks/**/__pycache__/
benchmarks/*.log
benchmarks/*.db
benchmark_*.db

